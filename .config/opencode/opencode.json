{
  "$schema": "https://opencode.ai/config.json",
  "update": "auto",
  "plugins": [
    "@plannotator/opencode@latest"
  ],
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "disabled": false
      },
      "grep_app": {
        "type": "remote",
        "url": "https://mcp.grep.app",
        "disabled": false
      },
      "opensrc": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "opensrc-mcp"
        ],
        "disabled": false
      },
    "executor": {
      "type": "remote",
      "url": "http://localhost:4788/mcp",
      "oauth": {
        "callback_port": 19876
      },
      "disabled": false
      },
      "t3n-mcp": {
        "type": "remote",
        "url": "http://127.0.0.1:8082/mcp",
        "oauth": false,
        "disabled": true,
        "headers": {
          "X-T3N-Api-Key": "{env:T3N_API_KEY}"
        }
      },
      "t3n-demo-mcp-with-auth": {
        "type": "remote",
        "url": "https://demo.mcp.terminal3.io/mcp",
        "oauth": false,
        "disabled": true,
        "headers": {
          "X-T3N-Api-Key": "{env:T3N_DEMO_API_KEY}"
        }
      },
      "t3n-demo-mcp": {
        "type": "remote",
        "url": "https://demo.mcp.terminal3.io/mcp",
        "oauth": false,
        "disabled": true
      },
      "hsbc-t3n-mcp": {
        "type": "remote",
        "url": "https://hsbc.mcp.terminal3.io/mcp",
        "oauth": false,
        "disabled": true,
        "headers": {
          "X-T3N-Api-Key": "{env:HSBC_T3N_API_KEY}"
        }
      }
    }
  },
  "permissions": [
    { "action": "context7_*", "resource": "*", "effect": "deny" },
    { "action": "grep_app_*", "resource": "*", "effect": "deny" },
    { "action": "opensrc_*", "resource": "*", "effect": "deny" }
  ],
  "agents": {
    "librarian": {
      "permissions": [
        { "action": "context7_*", "resource": "*", "effect": "allow" },
        { "action": "grep_app_*", "resource": "*", "effect": "allow" },
        { "action": "opensrc_*", "resource": "*", "effect": "allow" }
      ]
    },
    "title": {
      "model": "opencode-go/qwen3.7-plus"
    }
  },
  "providers": {
    "openai": {
      "settings": {
        "baseURL": "http://127.0.0.1:8317/v1",
        "apiKey": "{env:CLI_PROXY_API_KEY}",
        "headerTimeout": 30000
      }
    }
  }
}
