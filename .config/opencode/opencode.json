{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "plugin": [
    "@plannotator/opencode@latest",
    "./plugins/t3n-delegation-inject.js"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "grep_app": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "opensrc": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "opensrc-mcp"
      ],
      "enabled": true
    },
    "executor": {
      "type": "remote",
      "url": "http://192.168.50.10:4788/mcp",
      "enabled": true
    },
    "t3n-mcp-testnet": {
      "type": "local",
      "enabled": true,
      "command": [
        "node",
        "/home/edward/work/t3/z-trinity/trinity/client/mcp/t3n-mcp/bin/t3n-mcp.js",
        "--env=testnet"
      ],
      "environment": {
        "PRIVATE_KEY": "{env:T3N_PRIVATE_KEY}",
        "T3N_MCP_AGENT_SECRET_HEX": "{env:T3N_MCP_AGENT_SECRET_HEX}",
        "T3N_Z_PAYROLL_CONTRACT_VERSION": "1.3.2"
      }
    }
  },
  "tools": {
    "context7_*": false,
    "grep_app_*": false,
    "opensrc_*": false
  },
  "agent": {
    "librarian": {
      "tools": {
        "context7_*": true,
        "grep_app_*": true,
        "opensrc_*": true
      },
      "options": {},
      "permission": {
        "context7_*": "allow",
        "grep_app_*": "allow",
        "opensrc_*": "allow"
      }
    }
  },
  "provider": {
    "openai": {
      "options": {
        "baseURL": "http://127.0.0.1:8317/v1",
        "apiKey": "{env:CLI_PROXY_API_KEY}",
        "headerTimeout": 30000
      }
    }
  },
  "small_model": "opencode-go/deepseek-v4-flash"
}
